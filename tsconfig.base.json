{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2023", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "paths": {
      "@restaurant-ordering/server/common/http": ["./libs/server/common/http/src/index.ts"],
      "@restaurant-ordering/server/infrastructure/sse": [
        "./libs/server/infrastructure/sse/src/index.ts"
      ],
      "@restaurant-ordering/server/modules/categories": [
        "./libs/server/modules/categories/src/index.ts"
      ],
      "@restaurant-ordering/server/modules/menu": ["./libs/server/modules/menu/src/index.ts"],
      "@restaurant-ordering/server/modules/menu-items": [
        "./libs/server/modules/menu-items/src/index.ts"
      ],
      "@restaurant-ordering/web/common/zod": ["./libs/web/common/zod/src/index.ts"],
      "@restaurant-ordering/web/core/menu": ["./libs/web/core/menu/src/index.ts"],
      "@restaurant-ordering/web/infrastructure/http": [
        "./libs/web/infrastructure/http/src/index.ts"
      ],
      "@restaurant-ordering/web/infrastructure/rest": [
        "./libs/web/infrastructure/rest/src/index.ts"
      ],
      "@restaurant-ordering/web/infrastructure/sse": ["./libs/web/infrastructure/sse/src/index.ts"],
      "@restaurant-ordering/web/modules/menu": ["./libs/web/modules/menu/src/index.ts"],
      "@restaurant-ordering/web/modules/menu-setup": ["./libs/web/modules/menu-setup/src/index.ts"],
      "@restaurant-ordering/web/modules/orders": ["./libs/web/modules/orders/src/index.ts"],
      "@restaurant-ordering/web/modules/shell": ["./libs/web/modules/shell/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
