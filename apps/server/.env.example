# development | production. Swagger UI (/docs) is served outside production only.
NODE_ENV=development

# Server port.
PORT=3000

# Origin of the client app — the only allowed CORS origin.
CLIENT_ORIGIN=http://localhost:4200

# Speeds up the simulated kitchen: 1 is real time, 0.02 makes an order collected in ~1.5 s (e2e).
KITCHEN_TIME_SCALE=1
