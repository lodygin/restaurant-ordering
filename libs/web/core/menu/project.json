{
  "name": "web-core-menu",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/core/menu/src",
  "projectType": "library",
  "prefix": "app",
  "tags": ["platform:web"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "parallel": false,
        "commands": [
          "ngc -p libs/web/core/menu/tsconfig.lib.json --noEmit",
          "ngc -p libs/web/core/menu/tsconfig.spec.json --noEmit"
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/web/core/menu/vitest.config.mts"
      }
    }
  }
}
